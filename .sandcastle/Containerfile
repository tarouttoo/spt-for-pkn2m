FROM node:24-bookworm

# Install system dependencies (Python for CAD check scripts, Node for the harness)
RUN apt-get update && apt-get install -y \
  git \
  curl \
  jq \
  python3 \
  python3-pip \
  && rm -rf /var/lib/apt/lists/*

# uv runs the deterministic CAD checks (cadgen) used by .scratch/*/cad
RUN pip3 install --break-system-packages --no-cache-dir uv

# Install GitHub CLI (the sandboxed agent reads issues and leaves its report comment)
RUN curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
  | dd of=/usr/share/keyrings/githubcli-archive-keyring.gpg \
  && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
  | tee /etc/apt/sources.list.d/github-cli.list > /dev/null \
  && apt-get update && apt-get install -y gh \
  && rm -rf /var/lib/apt/lists/*

# Build-args for UID/GID alignment: they must match podman()'s containerUid/
# containerGid (default 1000) so image-built files and keep-id-mapped
# bind-mounted files share one owner.
ARG AGENT_UID=1000
ARG AGENT_GID=1000

# Rename the base image's "node" user to "agent" and align UID/GID.
RUN groupmod -o -g $AGENT_GID node && usermod -o -u $AGENT_UID -g $AGENT_GID -d /home/agent -m -l agent node

# Install pi coding agent — the same package the hosted workflow installs on
# the runner, so sandboxed and host runs use one pi. Build the image with:
#   podman build -t sandcastle:spt-for-pkn2m -f .sandcastle/Containerfile .sandcastle
RUN npm install -g @earendil-works/pi-coding-agent

USER ${AGENT_UID}:${AGENT_GID}

WORKDIR /home/agent

# In worktree sandbox mode, Sandcastle bind-mounts the git worktree at /home/agent/workspace
# and overrides the working directory to /home/agent/workspace at container start.
# Structure your Containerfile so that /home/agent/workspace can serve as the project root.
ENTRYPOINT ["sleep", "infinity"]
